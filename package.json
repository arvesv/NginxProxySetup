{
  "name": "npm-manager-cli",
  "version": "1.0.0",
  "type": "module",
  "description": "A powerful TypeScript CLI and SDK for Nginx Proxy Manager (NPM)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "npm-cli": "dist/bin/npm-cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx bin/npm-cli.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nginx-proxy-manager",
    "npm",
    "reverse-proxy",
    "cli",
    "letsencrypt",
    "gitops",
    "iac"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.2",
    "inquirer": "^12.4.1",
    "ora": "^8.2.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
