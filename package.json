{
  "name": "@arvesv/npm-manager-cli",
  "version": "1.0.0",
  "type": "module",
  "description": "A powerful TypeScript CLI and SDK for Nginx Proxy Manager (NPM)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "npm-cli": "dist/bin/npm-cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvesv/NginxProxySetup.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "tsx bin/npm-cli.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nginx-proxy-manager",
    "npm",
    "reverse-proxy",
    "cli",
    "letsencrypt",
    "gitops",
    "iac"
  ],
  "author": "Arve Svendsen",
  "license": "GPL-2.0",
  "dependencies": {
    "axios": "^1.7.9",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "dotenv": "^18.0.5",
    "form-data": "^4.0.2",
    "inquirer": "^14.2.2",
    "ora": "^9.4.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
